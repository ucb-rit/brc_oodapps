#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"
#
# Start Jupyter Notebook Server
#
module purge
module load ml/ray/2.54.1

export PYTHONNOUSERSITE=<%= context.python_no_user %>

# Ray Cluster and Dashboard Stuff (for multinode get the number of nodes and number of workers)
head_node=$(hostname)
head_node_ip=$(hostname --ip-address)

export RAY_GRAFANA_HOST="http://${head_node_ip}:3000"
export RAY_PROMETHEUS_HOST="http://${head_node_ip}:9090"
export RAY_GRAFANA_IFRAME_HOST="https://ood.brc.berkeley.edu/rnode/${head_node}/3000"

export RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0
export RAY_ADDRESS=${head_node_ip}:${ray_port}

# End Ray Cluster Stuff

# Benchmark info
echo "TIMING - Starting Ray at: $(date)"

# Launch the Ray Cluster

#set -x

ray start --head --dashboard-host=0.0.0.0 \
                 --port=${ray_port} \
                 --dashboard-port=${dashboard_port} \
                 --node-ip-address="$head_node_ip"\
                 --block 2>&1 &

sleep 5

echo "Give Ray time to initialize"

sleep 35

BASE_TMPDIR="${TMPDIR:-/tmp}"

echo "Starting prometheus and grafana at: $(date)"

cd ${BASE_TMPDIR}/ray/session_latest/metrics/prometheus

${PYTHON_DIR}/prometheus-3.9.1.linux-amd64/prometheus \
        --config.file=${BASE_TMPDIR}/ray/session_latest/metrics/prometheus/prometheus.yml > /dev/null 2>&1 &

cat <<EOF >> "${BASE_TMPDIR}/ray/session_latest/metrics/grafana/grafana.ini"

[server]
root_url = https://ood.brc.berkeley.edu/rnode/${head_node}/3000
server_from_sub_path = true

[paths]
data = /dev/shm/data-${SLURM_JOBID}
logs = ${BASE_TMPDIR}/ray/session_latest/metrics/grafana/logs
EOF

export GRAFANA_HOME=${PYTHON_DIR}/grafana-12.4.2
cd $HOME
sleep 5

${GRAFANA_HOME}/bin/grafana-server \
        --config "${BASE_TMPDIR}/ray/session_latest/metrics/grafana/grafana.ini" \
        --homepath "${GRAFANA_HOME}" web > /dev/null 2>&1 &

n_workers=$((SLURM_JOB_NUM_NODES -1))

if [ "$n_workers" -gt 0 ]; then
  echo "Launching ${n_workers} worker nodes..."
  srun --export=ALL -n $n_workers --nodes=$n_workers \
                      --ntasks-per-node=1 \
                      --exclude $head_node \
                      ray start --address=${head_node_ip}:${ray_port} --block  > /dev/null 2>&1 &
  sleep 5
fi

echo "Starting Jupyter at: $(date)"
jupyter lab --config="${CONFIG_FILE}" <%= context.extra_jupyterlab_args %>
